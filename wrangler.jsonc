{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flower-shop-stage2-images",
  "compatibility_date": "2026-10-14",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flower-shop-demo",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FLOWER_IMAGES",
      "bucket_name": "flower-shop-photos"
    }
  ]
}
