{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flower-shop-stage3c-pos-demo",
  "compatibility_date": "2026-10-14",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flower-shop-demo",
      "database_id": "983e19d7-b9a7-44cf-8f3f-dd6e483b9a31",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FLOWER_IMAGES",
      "bucket_name": "flower-shop-photos"
    }
  ]
}
